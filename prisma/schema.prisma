// Prisma schema: the single source of truth for the database structure.
// Docs: https://pris.ly/d/prisma-schema
//
// Conventions (apply to every model added from module 02 onwards):
// - Primary keys: `id String @id @default(uuid(7)) @db.Uuid` (time-ordered UUID v7)
// - Timestamps:   `createdAt DateTime @default(now()) @map("created_at")`
//                 `updatedAt DateTime @updatedAt @map("updated_at")`
// - Names:        camelCase in TypeScript, snake_case in the database (@map / @@map)
// - Money:        `Decimal @db.Decimal(12, 2)`, never Float

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

// The connection URL is not set here. The CLI reads it from prisma.config.ts
// (DIRECT_URL) and the app passes DATABASE_URL to the pg driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  /// Registered but email not verified yet (set by auth in module 12)
  INACTIVE
  ACTIVE
  /// Blocked by an admin; can't log in
  BANNED

  @@map("user_status")
}

/// A person with an account (customer, staff member or admin).
/// Auth fields (password hash, email verification) are added in module 12.
model User {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lowercase (normalized by validation before saving)
  email     String     @unique @db.VarChar(255)
  name      String     @db.VarChar(100)
  /// Normalized E.164 format, e.g. +8801712345678 (validated in module 13)
  phone     String?    @db.VarChar(20)
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(INACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
