# Copy this file to .env and fill in the values.
# Every variable used by the app is validated in src/config/env.ts; the app
# won't start if one is missing or invalid.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on (the frontend uses 3000)
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- PostgreSQL (Neon) ---------------------------------------------------
# Neon console → Connect. Use the POOLED connection string (host contains
# "-pooler") for the app, and change `sslmode=require` to `sslmode=verify-full`
# (same security as today, and silences node-postgres' deprecation warning).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Same string WITHOUT "-pooler" in the host, keeping `sslmode=require`.
# Only the Prisma CLI uses it (migrations need a direct connection).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Max connections in the app's pool (optional, default 10)
# DATABASE_POOL_MAX=10

# --- Redis (Upstash) ------------------------------------------------------
# Upstash console → your database → REST API section.
UPSTASH_REDIS_REST_URL="https://your-db-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# --- HTTP / security (all optional) --------------------------------------
# Browser origins allowed to call the API with cookies (comma-separated)
# CORS_ORIGINS=http://localhost:3000
# Behind a proxy (Render/Railway) set to 1 so req.ip is the real client IP
# TRUST_PROXY=false
# Global rate limit: max requests per IP per window
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# Interactive API docs at /docs and spec at /openapi.json
# (default: on in development, off in production)
# DOCS_ENABLED=true
